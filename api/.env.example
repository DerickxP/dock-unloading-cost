# Copie para .env e ajuste. O .env nunca vai para o git.

PORT=3000

# Postgres da aplicação. Em desenvolvimento: docker compose up -d postgres
DATABASE_URL="postgresql://dock:dock@localhost:5434/dock?schema=public"

# Chave enviada no header x-admin-key para as rotas de administração
# (cadastro de produtos e lojas, descarte de nota). Gere um valor forte:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=troque-esta-chave
